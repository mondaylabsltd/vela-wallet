{
  "name": "vela-wallet",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "Root tooling package: the generators, gates and npm oracles the shared corpus is replayed against. The shells live in app-web/, app-desktop/, app-ios/ and app-android/ with their own toolchains; nothing here builds an app.",
  "scripts": {
    "gen:i18n": "node scripts/gen-i18n.mjs",
    "lint:i18n": "node scripts/lint-i18n-corpus.mjs",
    "verify:i18n": "node scripts/verify-i18n-parity.mjs",
    "verify:identicon": "node scripts/verify-identicon-parity.mjs",
    "dump:vectors": "node scripts/dump-vectors/identicon.dump.mjs && node scripts/dump-vectors/i18n.dump.mjs",
    "gen:identicon-features": "node scripts/gen-identicon-features.mjs",
    "gen:passkey-providers": "node scripts/gen-passkey-providers.mjs",
    "lint:passkey-providers": "node scripts/gen-passkey-providers.mjs --check",
    "lint:lottie": "node scripts/lint-lottie-assets.mjs",
    "lint:lottie:self-test": "node scripts/lint-lottie-assets.mjs --self-test",
    "check:native-reachability": "node scripts/check-native-reachability.mjs",
    "check:expo-residue": "node scripts/check-expo-residue.mjs --self-test && node scripts/check-expo-residue.mjs",
    "build:wasm": "node rust/scripts/build-web.mjs",
    "verify:wasm": "node rust/scripts/verify-web.mjs",
    "bench:core": "node rust/scripts/bench-web.mjs",
    "gen:core-types": "node rust/scripts/gen-core-types.mjs",
    "gen:onboarding-types": "node rust/scripts/gen-onboarding-types.mjs",
    "test:core": "cd rust && cargo test -p vela-core --features crux,i18n-all"
  },
  "dependencies": {
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "i18next": "^26.3.1",
    "identicons-esm": "1.0.1"
  },
  "devDependencies": {
    "typescript": "~5.9.2"
  }
}
