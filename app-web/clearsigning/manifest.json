{
  "manifest_version": 3,
  "name": "Vela Clear Signing",
  "version": "0.1.0",
  "description": "Static hello-world shell that runs both as a web page and as a Chrome extension.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "host_permissions": [
    "https://getvela.app/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://getvela.app/*"
    ]
  },
  "action": {
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    },
    "default_title": "Vela Clear Signing"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
