{
	"name": "wallet.getvela.app",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "bun@1.4.2",
	"scripts": {
		"dev": "node scripts/sync-wasm.mjs && vite dev",
		"gen:tokens": "node scripts/gen-tokens.mjs",
		"sync:wasm": "node scripts/sync-wasm.mjs",
		"build": "node scripts/gen-tokens.mjs --check && node scripts/sync-wasm.mjs && wrangler types && vite build",
		"build:extension": "bun extension/build.mjs",
		"build:extension:safari": "bun extension/build.mjs --safari",
		"package:extension": "bun extension/build.mjs --zip",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"prepare": "svelte-kit sync || echo ''",
		"check": "node scripts/gen-tokens.mjs --check && node scripts/sync-wasm.mjs --check && node ../../rust/scripts/gen-core-types.mjs wallet-state session --check && wrangler types && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "bun run test:unit --run && bun run test:e2e",
		"test:e2e": "playwright install && playwright test",
		"gen": "wrangler types"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.65.1",
		"@sveltejs/adapter-cloudflare": "^7.2.10",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^2.70.4",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^22.20.5",
		"@vitest/browser-playwright": "^4.1.12",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"playwright": "^1.65.1",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.2",
		"vite": "^8.3.8",
		"vitest": "^4.1.12",
		"vitest-browser-svelte": "^2.1.1",
		"wrangler": "^4.162.0"
	},
	"trustedDependencies": []
}
