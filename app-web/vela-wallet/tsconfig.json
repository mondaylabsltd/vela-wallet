{
	"extends": "$app/tsconfig",
	// `include` is stated here, relative to this file. rolldown's tsconfig
	// reader resolves globs against the file that declares them; without them
	// here it concludes `src/` is not covered and keeps walking up the tree for
	// a tsconfig that does (found when that walk landed on the retired Expo
	// app's root tsconfig in a Cloudflare build). `$app/tsconfig` sets the
	// compiler options and no `include`.
	"include": ["src", "vite.config.ts", "playwright*.config.ts", "vitest-setup-client.ts"],
	"compilerOptions": {
		"checkJs": false,
		"sourceMap": true,
		"strict": true,
		"types": ["$app/types", "./worker-configuration.d.ts"]
	}
}
