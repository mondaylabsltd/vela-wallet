{
	"manifest_version": 3,
	"name": "Vela Wallet",
	"version": "0.1.0",
	"description": "The passkey wallet, in your browser. One address across 12+ networks, no seed phrase.",
	"key": "",
	"minimum_chrome_version": "116",
	"icons": {
		"16": "icons/icon-16.png",
		"32": "icons/icon-32.png",
		"48": "icons/icon-48.png",
		"128": "icons/icon-128.png"
	},
	"action": {
		"default_title": "Vela Wallet",
		"default_icon": {
			"16": "icons/icon-16.png",
			"32": "icons/icon-32.png",
			"48": "icons/icon-48.png",
			"128": "icons/icon-128.png"
		}
	},
	"background": {
		"service_worker": "background.js"
	},
	"side_panel": {
		"default_path": "panel.html"
	},
	"permissions": ["storage", "tabs", "sidePanel"],
	"host_permissions": ["https://getvela.app/*", "*://*/*"],
	"content_security_policy": {
		"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
	},
	"content_scripts": [
		{
			"matches": ["*://*/*"],
			"js": ["inpage.js"],
			"run_at": "document_start",
			"world": "MAIN",
			"all_frames": false
		},
		{
			"matches": ["*://*/*"],
			"js": ["content.js"],
			"run_at": "document_start",
			"all_frames": false
		}
	],
	"web_accessible_resources": [
		{
			"resources": ["inpage.js"],
			"matches": ["*://*/*"]
		}
	]
}
