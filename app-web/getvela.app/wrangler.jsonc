{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "getvela",
	"compatibility_flags": ["nodejs_compat"],
	"compatibility_date": "2025-08-05",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	}
	// The download mirror (spec 065, A5). COMMENTED OUT ON PURPOSE: a binding to a
	// bucket that does not exist fails `wrangler deploy`, and this site deploys on
	// every merge to main. Order matters:
	//   1. bunx wrangler r2 bucket create vela-downloads     (an account resource)
	//   2. uncomment the block below (and the comma above it), merge
	// Until then `/download/<platform>` redirects to GitHub — the same fallback it
	// uses whenever the mirror cannot serve, so nothing is broken in between.
	//
	// ,"r2_buckets": [{ "binding": "DOWNLOADS", "bucket_name": "vela-downloads" }]
}
