{
	"name": "getvela.app",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "bun run build && wrangler dev",
		"deploy": "vitest run && bun run build && wrangler deploy",
		"cf-typegen": "wrangler types types/worker-configuration.d.ts",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright test",
		"i18n:status": "bun run scripts/i18n-status.ts",
		"i18n:stamp": "bun run scripts/i18n-stamp.ts",
		"deploy:passkey-factory": "node scripts/deploy-passkey-factory.mjs",
		"i18n:stamp:doc": "bun run scripts/i18n-stamp-doc.ts"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.65.1",
		"@sveltejs/adapter-cloudflare": "^7.2.10",
		"@sveltejs/kit": "^2.70.4",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^24.19.2",
		"@vitest/browser-playwright": "^4.1.12",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"mdsvex": "^0.12.8",
		"playwright": "^1.65.1",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^3.5.2",
		"shiki": "^4.6.0",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.72.2",
		"vite": "^8.3.8",
		"vitest": "^4.1.12",
		"vitest-browser-svelte": "^3.1.0",
		"wrangler": "^4.162.0"
	},
	"dependencies": {
		"@resvg/resvg-wasm": "^2.6.2",
		"satori": "^0.26.0",
		"viem": "^2.54.6"
	},
	"trustedDependencies": []
}
