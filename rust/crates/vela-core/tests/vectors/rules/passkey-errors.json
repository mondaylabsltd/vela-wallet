    { "name": "ios/not_handled_1003", "platform": "ios", "domain": "ASAuthorizationErrorDomain", "code": 1003, "message": "", "expect": { "kind": "not_supported", "key": "onboarding.common.passkeyError.notSupported", "failure": "not_supported" } },
    { "name": "ios/failed_1004", "platform": "ios", "domain": "ASAuthorizationErrorDomain", "code": 1004, "message": "无法完成操作。", "expect": { "kind": "other", "key": "onboarding.common.passkeyError.other", "failure": "other" } },
    { "name": "ios/failed_1004_not_associated", "platform": "ios", "domain": "com.apple.AuthenticationServices.AuthorizationError", "code": 1004, "message": "Application with identifier ABCDE12345.app.getvela.wallet is not associated with domain getvela.app", "expect": { "kind": "app_not_associated", "key": "onboarding.common.passkeyError.appNotAssociated", "failure": "other" } },
    { "name": "ios/not_interactive_1005", "platform": "ios", "domain": "ASAuthorizationErrorDomain", "code": 1005, "message": "", "expect": { "kind": "not_supported", "key": "onboarding.common.passkeyError.notSupported", "failure": "not_supported" } },
    { "name": "ios/matched_excluded_1006", "platform": "ios", "domain": "ASAuthorizationErrorDomain", "code": 1006, "message": "", "expect": { "kind": "already_registered", "key": "onboarding.common.passkeyError.alreadyRegistered", "failure": "other" } },
    { "name": "ios/url_not_connected", "platform": "ios", "domain": "NSURLErrorDomain", "code": -1009, "message": "The Internet connection appears to be offline.", "expect": { "kind": "no_network", "key": "onboarding.common.passkeyError.noNetwork", "failure": "other" } },
    { "name": "ios/url_timed_out", "platform": "ios", "domain": "NSURLErrorDomain", "code": -1001, "message": "", "expect": { "kind": "timed_out", "key": "onboarding.common.passkeyError.timedOut", "failure": "cancelled" } },
    { "name": "ios/web_kit", "platform": "ios", "domain": "WKErrorDomain", "code": 1, "message": "", "expect": { "kind": "other", "key": "onboarding.common.passkeyError.other", "failure": "other" } },
    { "name": "ios/a_bracketed_number_is_not_a_play_code", "platform": "ios", "domain": "SomeOtherDomain", "code": null, "message": "[50152] RP ID cannot be validated.", "expect": { "kind": "other", "key": "onboarding.common.passkeyError.other", "failure": "other" } },
    { "name": "macos/canceled", "platform": "macos", "domain": "ASAuthorizationErrorDomain", "code": 1001, "message": "", "expect": { "kind": "cancelled", "key": "onboarding.common.passkeyError.cancelled", "failure": "cancelled" } },
    { "name": "web/not_allowed", "platform": "web", "domain": "NotAllowedError", "code": null, "message": "The operation either timed out or was not allowed.", "expect": { "kind": "cancelled", "key": "onboarding.common.passkeyError.cancelled", "failure": "cancelled" } },
    { "name": "web/abort", "platform": "web", "domain": "AbortError", "code": null, "message": "", "expect": { "kind": "cancelled", "key": "onboarding.common.passkeyError.cancelled", "failure": "cancelled" } },
    { "name": "web/invalid_state", "platform": "web", "domain": "InvalidStateError", "code": null, "message": "The user attempted to register an authenticator that contains one of the credentials already registered with the relying party.", "expect": { "kind": "already_registered", "key": "onboarding.common.passkeyError.alreadyRegistered", "failure": "other" } },
    { "name": "web/security", "platform": "web", "domain": "SecurityError", "code": null, "message": "The relying party ID is not a registrable domain suffix of, nor equal to the current domain.", "expect": { "kind": "app_not_associated", "key": "onboarding.common.passkeyError.appNotAssociated", "failure": "other" } },
    { "name": "web/not_supported", "platform": "web", "domain": "NotSupportedError", "code": null, "message": "", "expect": { "kind": "not_supported", "key": "onboarding.common.passkeyError.notSupported", "failure": "not_supported" } },
    { "name": "web/timeout", "platform": "web", "domain": "TimeoutError", "code": null, "message": "", "expect": { "kind": "timed_out", "key": "onboarding.common.passkeyError.timedOut", "failure": "cancelled" } },
    { "name": "web/unknown", "platform": "web", "domain": "UnknownError", "code": null, "message": "An unknown error occurred while talking to the credential manager.", "expect": { "kind": "other", "key": "onboarding.common.passkeyError.other", "failure": "other" } },
    { "name": "any/phone_link_core_words", "platform": "android", "domain": "", "code": null, "message": "caBLE transport: tunnel closed", "expect": { "kind": "phone_unreachable", "key": "onboarding.common.phoneLinkFailed", "failure": "other" } },
    { "name": "any/nothing_known", "platform": "", "domain": "", "code": null, "message": "", "expect": { "kind": "other", "key": "onboarding.common.passkeyError.other", "failure": "other" } }
  ]
