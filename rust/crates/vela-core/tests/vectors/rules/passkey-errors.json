{
  "about": "A passkey prompt's failure, said in the person's language (round 10, real-device S3). Each case: the platform error's facts as a shell reads them (platform, domain = exception class / type / NSError domain / DOMException name, code, raw message) → app::passkey_error::passkey_error_words: kind, corpus key, and the FailureKind the onboarding machines branch on. Replayed by tests/app_passkey_error.rs; the native shells replay it through the uniffi export passkey_error_words, the web through the wasm export passkeyErrorWords.",
  "cases": [
    { "name": "android/cancelled_get", "platform": "android", "domain": "androidx.credentials.exceptions.GetCredentialCancellationException", "code": null, "message": "activity is cancelled by the user.", "expect": { "kind": "cancelled", "key": "onboarding.common.passkeyError.cancelled", "failure": "cancelled" } },
    { "name": "android/cancelled_create_simple_name", "platform": "android", "domain": "CreateCredentialCancellationException", "code": null, "message": "", "expect": { "kind": "cancelled", "key": "onboarding.common.passkeyError.cancelled", "failure": "cancelled" } },
    { "name": "android/rp_id_50152_in_message", "platform": "android", "domain": "androidx.credentials.exceptions.GetCredentialUnknownException", "code": null, "message": "[50152] RP ID cannot be validated.", "expect": { "kind": "app_not_associated", "key": "onboarding.common.passkeyError.appNotAssociated", "failure": "other" } },
    { "name": "android/rp_id_50152_as_code", "platform": "android", "domain": "androidx.credentials.exceptions.CreateCredentialUnknownException", "code": 50152, "message": "", "expect": { "kind": "app_not_associated", "key": "onboarding.common.passkeyError.appNotAssociated", "failure": "other" } },
    { "name": "android/no_credential", "platform": "android", "domain": "androidx.credentials.exceptions.NoCredentialException", "code": null, "message": "No credentials available", "expect": { "kind": "no_credential", "key": "onboarding.common.passkeyError.noCredential", "failure": "other" } },
    { "name": "android/no_credential_by_type", "platform": "android", "domain": "android.credentials.GetCredentialException.TYPE_NO_CREDENTIAL", "code": null, "message": "", "expect": { "kind": "no_credential", "key": "onboarding.common.passkeyError.noCredential", "failure": "other" } },
    { "name": "android/provider_configuration", "platform": "android", "domain": "androidx.credentials.exceptions.GetCredentialProviderConfigurationException", "code": null, "message": "getCredentialAsync no provider dependencies found", "expect": { "kind": "not_supported", "key": "onboarding.common.passkeyError.notSupported", "failure": "not_supported" } },
    { "name": "android/unsupported", "platform": "android", "domain": "GetCredentialUnsupportedException", "code": null, "message": "", "expect": { "kind": "not_supported", "key": "onboarding.common.passkeyError.notSupported", "failure": "not_supported" } },
    { "name": "android/no_create_option", "platform": "android", "domain": "androidx.credentials.exceptions.CreateCredentialNoCreateOptionException", "code": null, "message": "", "expect": { "kind": "not_supported", "key": "onboarding.common.passkeyError.notSupported", "failure": "not_supported" } },
    { "name": "android/interrupted", "platform": "android", "domain": "androidx.credentials.exceptions.GetCredentialInterruptedException", "code": null, "message": "", "expect": { "kind": "other", "key": "onboarding.common.passkeyError.other", "failure": "other" } },
    { "name": "android/dom_invalid_state", "platform": "android", "domain": "androidx.credentials.TYPE_INVALID_STATE_ERROR", "code": null, "message": "One of the excluded credentials exists on the local device", "expect": { "kind": "already_registered", "key": "onboarding.common.passkeyError.alreadyRegistered", "failure": "other" } },
    { "name": "android/dom_type_string_whole", "platform": "android", "domain": "androidx.credentials.TYPE_CREATE_PUBLIC_KEY_CREDENTIAL_DOM_EXCEPTION/androidx.credentials.TYPE_NOT_ALLOWED_ERROR", "code": null, "message": "", "expect": { "kind": "cancelled", "key": "onboarding.common.passkeyError.cancelled", "failure": "cancelled" } },
    { "name": "android/dom_security", "platform": "android", "domain": "androidx.credentials.TYPE_SECURITY_ERROR", "code": null, "message": "", "expect": { "kind": "app_not_associated", "key": "onboarding.common.passkeyError.appNotAssociated", "failure": "other" } },
    { "name": "android/play_network_code", "platform": "android", "domain": "GetCredentialUnknownException", "code": 7, "message": "", "expect": { "kind": "no_network", "key": "onboarding.common.passkeyError.noNetwork", "failure": "other" } },
    { "name": "android/gpm_cannot_connect_is_generic", "platform": "android", "domain": "androidx.credentials.exceptions.GetCredentialUnknownException", "code": null, "message": "Your device can't connect", "expect": { "kind": "other", "key": "onboarding.common.passkeyError.other", "failure": "other" } },
    { "name": "ios/canceled_1001", "platform": "ios", "domain": "com.apple.AuthenticationServices.AuthorizationError", "code": 1001, "message": "The operation couldn’t be completed. (com.apple.AuthenticationServices.AuthorizationError error 1001.)", "expect": { "kind": "cancelled", "key": "onboarding.common.passkeyError.cancelled", "failure": "cancelled" } },
    { "name": "ios/unknown_1000", "platform": "ios", "domain": "ASAuthorizationErrorDomain", "code": 1000, "message": "The operation couldn’t be completed.", "expect": { "kind": "other", "key": "onboarding.common.passkeyError.other", "failure": "other" } },
