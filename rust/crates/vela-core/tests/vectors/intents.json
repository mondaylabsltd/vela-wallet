{
  "suite": "intents",
  "source": "hand-written from spec 103/104 and the owner's decisions (2026-10-20/21): what every shell's intents must answer — the check, the judgements over the wallet's state, a transfer's progress, and what an agent reads (vela_core::app::intent_json)",
  "cases": [
    {
      "name": "check/an-agent-never-touches-its-own-connection",
      "fn": "intent_check",
      "input": {
        "actor": "agent",
        "action": {
          "type": "configure_agent",
          "enabled": true,
          "bridge_url": null,
          "client_token": null
        },
        "grants": {
          "agent_enabled": true
        }
      },
      "expect": {
        "kind": "configure_agent",
        "risk": "manage",
        "decision": {
          "decision": "deny",
          "reason": {
            "code": "person_only",
            "detail": "only the person may change this"
          }
        }
      }
    },
    {
      "name": "check/an-agents-delete-waits-for-the-wallets-approval",
      "fn": "intent_check",
      "input": {
        "actor": "agent",
        "action": {
          "type": "delete_contact",
          "address": "0x00000000219ab540356cbb839cbe05303d7705fa"
        },
        "grants": {
          "agent_enabled": true
        }
      },
      "expect": {
        "kind": "delete_contact",
        "risk": "manage",
        "decision": {
          "decision": "approve",
          "by": "wallet"
        }
      }
    },
    {
      "name": "check/an-agents-confirm-only-asks",
      "fn": "intent_check",
      "input": {
        "actor": "agent",
        "action": {
          "type": "submit_transfer",
          "operation": "t1"
        },
        "grants": {
          "agent_enabled": true
        }
      },
      "expect": {
        "kind": "submit_transfer",
        "risk": "transact",
        "decision": {
          "decision": "allow"
        }
      }
    },
    {
      "name": "examine/already-so-asks-nothing",
      "fn": "intent_examine",
      "input": {
        "action": {
          "type": "save_contact",
          "address": "0x00000000219ab540356cbb839cbe05303d7705fa",
          "name": "Alice"
        },
        "world": {
          "contacts": {
            "loaded": true,
            "contacts": [
              {
                "address": "0x00000000219ab540356cbb839cbe05303d7705fa",
                "name": "Alice"
              }
            ],
            "groups": []
          }
        }
      },
      "expect": {
        "kind": "already"
      }
    },
    {
      "name": "examine/a-contact-that-is-not-there",
      "fn": "intent_examine",
      "input": {
        "action": {
          "type": "delete_contact",
          "address": "0x1111111111111111111111111111111111111111"
        },
        "world": {
          "contacts": {
            "loaded": true,
            "contacts": [
              {
                "address": "0x00000000219ab540356cbb839cbe05303d7705fa",
                "name": "Alice"
              }
            ],
            "groups": []
          }
        }
      },
      "expect": {
        "kind": "refused",
        "reason": {
          "code": "not_found",
          "detail": "no contact has that address"
        }
      }
    },
    {
      "name": "examine/an-unread-book-is-not-an-empty-one",
      "fn": "intent_examine",
      "input": {
        "action": {
          "type": "delete_contact",
          "address": "0x1111111111111111111111111111111111111111"
        },
        "world": {
          "contacts": {
            "loaded": false
          }
        }
      },
      "expect": {
        "kind": "refused",
        "reason": {
          "code": "not_ready",
          "detail": "the address book is not loaded yet"
        }
      }
    },
    {
      "name": "examine/an-action-this-build-cannot-read-is-refused",
      "fn": "intent_examine",
      "input": {
        "action": {
          "type": "launch_rockets"
        },
        "world": {}
      },
      "expect": {
        "kind": "refused",
        "reason": {
          "code": "invalid_input",
          "detail": "not an action this wallet knows"
        }
      }
    },
    {
      "name": "examine/a-built-in-network-is-not-removed",
      "fn": "intent_examine",
      "input": {
        "action": {
          "type": "remove_network",
          "chain_id": 1
        },
        "world": {
          "networks": {
            "networks": [
              {
                "chain_id": 1,
                "is_custom": false
              }
            ]
          }
        }
      },
      "expect": {
        "kind": "refused",
        "reason": {
          "code": "refused",
          "detail": "a network the wallet ships with cannot be removed"
        }
      }
    },
    {
      "name": "baseline/same-named-groups-before-a-new-one",
      "fn": "intent_baseline",
      "input": {
        "action": {
          "type": "save_group",
          "id": null,
          "name": " Work "
        },
        "world": {
          "contacts": {
            "loaded": true,
            "contacts": [],
            "groups": [
              {
                "id": "g1",
                "name": "Work",
                "members": []
              }
            ]
          }
        }
      },
      "expect": {
        "same_named_groups": 1,
        "sheet_up": false
      }
    },
    {
      "name": "verdict/a-sign-out-kept-on-its-sheet-is-denied",
      "fn": "intent_verdict",
      "input": {
        "action": {
          "type": "sign_out"
        },
        "world": {
          "session": {
            "has_wallet": true,
            "allowed_route": "wallet",
            "sign_out": null
          }
        },
        "baseline": {
          "same_named_groups": 0,
          "sheet_up": true
        }
      },
      "expect": {
        "verdict": {
          "kind": "refused",
          "reason": {
            "code": "denied",
            "detail": "the person kept the wallet signed in"
          }
        },
        "baseline": {
          "same_named_groups": 0,
          "sheet_up": true
        }
      }
    },
    {
      "name": "verdict/an-rpc-for-another-chain-is-refused",
      "fn": "intent_verdict",
      "input": {
        "action": {
          "type": "set_network_endpoint",
          "chain_id": 5042002,
          "field": "rpc",
          "url": "https://mainnet.example"
        },
        "world": {
          "networks": {
            "networks": [
              {
                "chain_id": 5042002,
                "rpc_url": "https://mainnet.example",
                "rpc_chain_mismatch": {
                  "expected": 5042002,
                  "got": 1
                }
              }
            ]
          }
        },
        "baseline": {
          "same_named_groups": 0,
          "sheet_up": false
        }
      },
      "expect": {
        "verdict": {
          "kind": "refused",
          "reason": {
            "code": "refused",
            "detail": "that RPC answers for another chain"
          }
        },
        "baseline": {
          "same_named_groups": 0,
          "sheet_up": false
        }
      }
    },
    {
      "name": "verdict/a-batch-deleted-by-its-hash-holds-once-every-record-is-gone",
      "fn": "intent_verdict",
      "input": {
        "action": {
          "type": "delete_activity",
          "id": "0xBATCH"
        },
        "world": {
          "feed": {
            "transactions": [
              {
                "id": "other",
                "user_op_hash": "0xelse"
              }
            ]
          }
        },
        "baseline": {
          "same_named_groups": 0,
          "sheet_up": false
        }
      },
      "expect": {
        "verdict": {
          "kind": "held"
        },
        "baseline": {
          "same_named_groups": 0,
          "sheet_up": false
        }
      }
    },
    {
      "name": "world-needs/deleting-a-record-reads-the-feed",
      "fn": "intent_world_needs",
      "input": {
        "action": {
          "type": "delete_activity",
          "id": "r1"
        }
      },
      "expect": {
        "value": [
          "feed"
        ]
      }
    },
    {
      "name": "progress/submitting-before-the-passkey-signs-is-awaiting-it",
      "fn": "intent_operation_progress",
      "input": {
        "progress": {
          "operation": {
            "id": "t1",
            "state": "awaiting_confirmation",
            "chain_id": 1,
            "user_op_hash": null,
            "tx_hash": null,
            "reason": null
          },
          "confirmed_after": 3
        },
        "send": {
          "stage": "confirm",
          "tx_status": "submitting"
        },
        "ceremony": {
          "event": "signed",
          "seq": 3
        },
        "tracker": []
      },
      "expect": {
        "operation": {
          "id": "t1",
          "state": "awaiting_passkey",
          "chain_id": 1,
          "user_op_hash": null,
          "tx_hash": null,
          "reason": null
        },
        "confirmed_after": 3
      }
    },
    {
      "name": "progress/its-own-ceremony-signing-is-submitting",
      "fn": "intent_operation_progress",
      "input": {
        "progress": {
          "operation": {
            "id": "t1",
            "state": "awaiting_passkey",
            "chain_id": 1,
            "user_op_hash": null,
            "tx_hash": null,
            "reason": null
          },
          "confirmed_after": 3
        },
        "send": {
          "stage": "confirm",
          "tx_status": "signing"
        },
        "ceremony": {
          "event": "signed",
          "seq": 4
        },
        "tracker": []
      },
      "expect": {
        "operation": {
          "id": "t1",
          "state": "submitting",
          "chain_id": 1,
          "user_op_hash": null,
          "tx_hash": null,
          "reason": null
        },
        "confirmed_after": 3
      }
    },
    {
      "name": "progress/the-chain-confirms-it-after-its-receipt-closed",
      "fn": "intent_operation_progress",
      "input": {
        "progress": {
          "operation": {
            "id": "t1",
            "state": "submitted",
            "chain_id": 1,
            "user_op_hash": "0xOP",
            "tx_hash": null,
            "reason": null
          },
          "confirmed_after": 1
        },
        "send": null,
        "ceremony": null,
        "tracker": [
          {
            "user_op_hash": "0xop",
            "status": "confirmed",
            "tx_hash": "0xTX"
          }
        ]
      },
      "expect": {
        "operation": {
          "id": "t1",
          "state": "confirmed",
          "chain_id": 1,
          "user_op_hash": "0xOP",
          "tx_hash": "0xTX",
          "reason": null
        },
        "confirmed_after": 1
      }
    },
    {
      "name": "progress/gone-before-signing-was-left-unsent",
      "fn": "intent_operation_progress",
      "input": {
        "progress": {
          "operation": {
            "id": "t1",
            "state": "awaiting_confirmation",
            "chain_id": 1,
            "user_op_hash": null,
            "tx_hash": null,
            "reason": null
          },
          "confirmed_after": null
        },
        "send": null,
        "ceremony": null,
        "tracker": []
      },
      "expect": {
        "operation": {
          "id": "t1",
          "state": "cancelled",
          "chain_id": 1,
          "user_op_hash": null,
          "tx_hash": null,
          "reason": "left the review without sending"
        },
        "confirmed_after": null
      }
    },
