<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG ONLY. The release build carries no network security config at all, so
  with targetSdk ≥ 28 it refuses every cleartext connection — the in-app
  browser cannot load an http page there, LAN or not (spec 088; owner ruling
  2026-10-02 for spec 091: store builds forbid it entirely).

  Spec 091: a debug build may load an http page on the developer's own
  network, because Settings' hidden debug mode (developer builds only) offers
  the wallet to such a page. A config cannot name IP ranges, so the base
  allows cleartext; which pages are offered the wallet stays the core's rule
  (`dapp_permissions::offers_wallet`) — public http never is.

  Spec 044: the local test dApp is served over the cable (`adb reverse
  tcp:8137 tcp:8137`) as plain http on the loopback address; that entry is
  kept so it holds whatever the base says.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
