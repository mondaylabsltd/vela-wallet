<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive-icon foreground layer: the Vela mark, transparent everywhere else.
    Path data is verbatim from docs/design/icon/app-mark.svg, whose viewBox is 68
    units, mapped into Android's 108-unit viewport by the group below.

    THE GROUP TRANSFORM IS LOAD-BEARING. Mapping 68 units straight onto 108
    (scale 1.5882) puts the sail tips and hull 108% of the way to the edge of
    the inner circle Android guarantees, so a circular launcher clips them.
    Scaling by 1.08 instead leaves the mark occupying 68% of the viewport,
    reproducing the proportion it has inside its own tile:

        scale     = 108/68 * 0.68 = 1.08
        translate = (108 - 68*1.08) / 2 = 17.28
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="1.08"
        android:scaleY="1.08"
        android:translateX="17.28"
        android:translateY="17.28">
        <path
            android:fillColor="#fff3ec"
            android:pathData="M33,12C25,21,20,32,17,42L33,42L33,12Z" />
        <path
            android:fillColor="#ffc6b0"
            android:pathData="M36,19C45,25,50,34,52,42L36,42L36,19Z" />
        <path
            android:fillColor="#5a4037"
            android:pathData="M13,46L55,46C52,52,47,55,40,55L28,55C21,55,16,52,13,46Z" />
    </group>
</vector>
