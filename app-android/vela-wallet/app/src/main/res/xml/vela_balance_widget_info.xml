<?xml version="1.0" encoding="utf-8"?>
<!-- The home-screen balance widget (native parity Phase 3). No network on it:
     the 30-minute redraw only ages its "Updated …" line from what the wallet
     last drew (VelaBalanceWidget). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="80dp"
    android:minResizeWidth="140dp"
    android:minResizeHeight="70dp"
    android:targetCellWidth="3"
    android:targetCellHeight="1"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:previewLayout="@layout/glance_default_loading_layout" />
