<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Splash background follows appearance (spec 012 FR-022); values/ carries
         the light value, values-night/ the dark one. -->
    <style name="Theme.VelaWallet" parent="Theme.SplashScreen.IconBackground">
        <item name="windowSplashScreenBackground">@color/vela_splash_bg</item>
        <!-- Spec 088: the app icon. core-splashscreen's default for this item is
             @android:drawable/sym_def_app_icon — Android's generic robot — on every
             API level, so every launch opened on a robot until this line. The
             adaptive icon's foreground layer is the mark alone, sized for the
             masked circle; its pale sails need the tile behind them, so the circle
             is filled with the tile colour (ic_launcher_background.xml's fill —
             keep the two in step, scripts/gen-app-icons.sh owns it). -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenIconBackgroundColor">#F46D50</item>
        <item name="postSplashScreenTheme">@style/Theme.VelaWallet.Main</item>
    </style>

    <!-- Day/night window chrome; all content theming is Compose-side (VelaTheme). -->
    <style name="Theme.VelaWallet.Main" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/vela_window_bg</item>
    </style>
</resources>
