<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Splash background follows appearance (spec 012 FR-022); values/ carries
         the light value, values-night/ the dark one. -->
    <style name="Theme.VelaWallet" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/vela_splash_bg</item>
        <!-- Issue #407: the launch animation's first frame — its mark, centred, on
             the same colour (splash_mark.xml says how it is matched). The
             animation then moves it left as the wordmark types in, so launch
             is one screen. The adaptive icon on its tile (spec 088) read as a
             second, unrelated screen first, and HyperOS draws the tile as a
             hard square. Never unset: core-splashscreen's default is Android's
             robot. -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_mark</item>
        <item name="postSplashScreenTheme">@style/Theme.VelaWallet.Main</item>
    </style>

    <!-- Day/night window chrome; all content theming is Compose-side (VelaTheme). -->
    <style name="Theme.VelaWallet.Main" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/vela_window_bg</item>
    </style>
</resources>
