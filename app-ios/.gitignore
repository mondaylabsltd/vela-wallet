# Xcode — per-user UI state (schemes, window layout, breakpoints)
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout

# Build output
DerivedData/
build/
*.ipa
*.dSYM.zip
*.dSYM

# Swift Package Manager — local resolution state + build output
.swiftpm/
.build/
Packages/
*.xcworkspace/xcshareddata/IDEWorkspaceChecks.plist

# CocoaPods / Carthage (if ever added)
Pods/
Carthage/Build/

# Signing material — never commit
*.mobileprovision
*.p12
*.cer

# VelaCoreKit binary artifacts — built by rust/scripts/build-ios-xcframework.sh
VelaCoreKit/Artifacts/
# The parallel space's keyset (spec 052, D1). Built by
# rust/scripts/build-ios-dev-fixtures.sh; Debug configurations only.
VelaDevFixturesKit/Artifacts/
