    "widget.balance.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your balance at a glance, as of the last time Vela updated it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一眼看到余额，以 Vela 最近一次更新为准。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一眼看到餘額，以 Vela 最近一次更新為準。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "一眼看到結餘，以 Vela 最近一次更新為準。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残高をひと目で。Vela が最後に更新した時点の金額です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잔액을 한눈에. Vela가 마지막으로 업데이트한 시점 기준입니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Số dư trong nháy mắt, theo lần cập nhật gần nhất của Vela."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saldo Anda sekilas, sesuai terakhir kali Vela memperbaruinya."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bakiyeniz bir bakışta, Vela'nın son güncellediği haliyle."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu saldo de un vistazo, según la última vez que Vela lo actualizó."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu saldo num relance, conforme a última atualização do Vela."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre solde en un coup d’œil, tel que Vela l’a mis à jour la dernière fois."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Guthaben auf einen Blick, so wie Vela es zuletzt aktualisiert hat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Баланс одним взглядом — на момент последнего обновления в Vela."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo saldo a colpo d'occhio, all'ultimo aggiornamento di Vela."
          }
        }
      }
    },
