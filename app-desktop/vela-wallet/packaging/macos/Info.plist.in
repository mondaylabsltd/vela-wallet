<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template for the macOS bundle. @VERSION@ is substituted by
  scripts/build-macos-app.sh from the version in Cargo.toml.
-->
<plist version="1.0">
<dict>
    <key>CFBundleName</key>              <string>Vela Wallet</string>
    <key>CFBundleDisplayName</key>       <string>Vela Wallet</string>
    <key>CFBundleIdentifier</key>        <string>app.getvela.VelaWallet</string>
    <key>CFBundleExecutable</key>        <string>vela-wallet</string>
    <!-- Names AppIcon.icns in Contents/Resources; the extension is omitted by
         convention and Finder will not find the icon if it is included. -->
    <key>CFBundleIconFile</key>          <string>AppIcon</string>
    <key>CFBundlePackageType</key>       <string>APPL</string>
    <key>CFBundleShortVersionString</key><string>@VERSION@</string>
    <key>CFBundleVersion</key>           <string>@VERSION@</string>
    <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
    <!-- The standard About panel's last line (app menu → About, spec 095). -->
    <key>NSHumanReadableCopyright</key>  <string>© MONDAY LABS LTD</string>
    <!-- gpui renders through Metal and expects a real backing-scale factor;
         without this the window is rendered at 1x and upscaled. -->
    <!-- Spec 076: the Trusted Signer's answer comes back as a navigation to
         `velawallet://sign-result`, because the published signing page carries
         `default-src 'none'` in its hashed bytes and cannot open a socket at
         all. macOS hands a URL only to a BUNDLE that declares the scheme, so
         without this the browser reports the navigation cancelled and the
         wallet waits out its timeout — which is exactly how it behaved before
         this key existed.

         The same scheme the phones already register. It is not exclusive: any
         app may claim it, which is why the callback carries a one-time token
         and the core still verifies the assertion itself. -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>       <string>app.getvela.VelaWallet.signer</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>velawallet</string>
            </array>
        </dict>
    </array>
    <!-- The in-app browser loads the web as the iOS app does (its Info.plist
         carries the same two keys): plain-http pages load — without the
         wallet, which a page only reaches from a secure context — and so do
         addresses on the local network. App Transport Security still covers
         everything else the process might fetch through Apple's stack; the
         wallet's own traffic is rustls over HTTPS and never reaches ATS. -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoadsInWebContent</key> <true/>
        <key>NSAllowsLocalNetworking</key>            <true/>
    </dict>
    <key>NSHighResolutionCapable</key>   <true/>
    <key>LSMinimumSystemVersion</key>    <string>11.0</string>
    <key>LSApplicationCategoryType</key> <string>public.app-category.finance</string>
    <key>NSSupportsAutomaticGraphicsSwitching</key><true/>
    <!-- caBLE / "sign in with your phone": the app scans for the phone's
         Bluetooth proximity advert to find the relay tunnel it opened. macOS
         refuses CoreBluetooth entirely to a process without this usage string —
         a bare `cargo run` binary cannot scan at all, so the hybrid transport
         MUST be exercised from the bundled .app. -->
    <key>NSBluetoothAlwaysUsageDescription</key>
    <string>Vela scans for your phone's Bluetooth signal to sign in with a passkey on it.</string>
    <!-- The scanner's live half (spec 036 phase 2). Asking for the camera
         WITHOUT this string is not a denied permission: macOS terminates the
         process. It went unseen because the scanner had only ever been run
         from `cargo run`, where the TERMINAL is the process TCC holds
         responsible and the terminal has a usage string of its own — the
         bundled .app is the first place this key is consulted (spec 063 §3). -->
    <key>NSCameraUsageDescription</key>
    <string>Vela uses the camera to scan a QR code — an address, a payment request, or a sign-in code.</string>
</dict>
</plist>
