[Desktop Entry]
Type=Application
# Spec version 1.0, not 1.5: Debian 12's desktop-file-validate (0.26) rejects
# versions it postdates, and the .deb build validates inside a debian:12
# container. The key only declares which spec the file follows.
Version=1.0
Name=Vela Wallet
GenericName=Crypto Wallet
Comment=Self-custodial smart wallet for EVM networks
Exec=vela-wallet %u
# Spec 076: the Clear Signer answers by navigating to `velawallet://sign-result`.
# `%u` above passes that URL to the app; this line is what makes the desktop
# environment route the scheme here at all.
MimeType=x-scheme-handler/velawallet;
Icon=app.getvela.VelaWallet
Terminal=false
Categories=Office;Finance;
Keywords=wallet;crypto;ethereum;evm;passkey;safe;erc4337;web3;
StartupNotify=true
# Matched against the Wayland xdg_toplevel app_id and the X11 WM_CLASS, both of
# which gpui sets from `WindowOptions::app_id` in src/main.rs. Change one and
# the shell falls back to a generic icon and the binary name in the dock.
StartupWMClass=app.getvela.VelaWallet
